# ==============================================================================
# RAZORPAY AGENT STUDIO - WOOCOMMERCE CONNECTOR CONFIGURATION
# ==============================================================================

# Mode Selection:
# Set to 'true' to use the zero-setup local sandbox with realistic seed data
# Set to 'false' to connect to a live WordPress/WooCommerce site
WOOCOMMERCE_MOCK=true

# Live Store Configuration (Required only if WOOCOMMERCE_MOCK=false):
WOOCOMMERCE_URL=https://your-store-domain.com
WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Proactive Client-Side Rate Limiter (Token Bucket Algorithm):
WOOCOMMERCE_RATE_LIMIT_RPS=5
WOOCOMMERCE_RATE_LIMIT_BURST=10

# Reactive Rate Limit Handling (HTTP 429 & 503 Backoff):
WOOCOMMERCE_MAX_RETRIES=3
WOOCOMMERCE_RETRY_BASE_DELAY_MS=500
WOOCOMMERCE_TIMEOUT_MS=10000
